{
  "name": "the-agent",
  "version": "6.1.0",
  "description": "The Agent · Our intelligent assistant",
  "author": "AppifyHub <contact@appifyhub.com>",
  "attribution": "Pasquale Vitiello <pasqualevitiello@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/appifyhub/the-agent.github.io.git"
  },
  "bugs": {
    "url": "https://github.com/appifyhub/the-agent.github.io/issues"
  },
  "scripts": {
    "autoprefixer": "postcss dist/css/*.css --use autoprefixer --no-map --replace",
    "clean": "rimraf dist",
    "imagemin": "imagemin src/images/* -o dist/images",
    "lint": "run-p lint-html lint-js lint-scss",
    "lint-html": "htmlhint index.html",
    "lint-js": "eslint src/js",
    "lint-scss": "stylelint \"src/scss/**/*.scss\"",
    "scss": "sass --style=compressed --no-source-map src/scss:dist/css",
    "serve": "browser-sync start --server --files \"dist/css/*.css, dist/js/*.js, **/*.html, !node_modules/**/*.html\"",
    "uglify": "mkdirp dist/js -p && uglifyjs src/js/*.js -m -c -o dist/js/main.min.js",
    "build:css": "run-s lint-scss scss autoprefixer",
    "build:html": "run-s lint-html",
    "build:js": "run-s lint-js uglify",
    "build:images": "run-s imagemin",
    "prebuild": "run-s clean",
    "build": "run-s build:* copy-assets",
    "bump": "bun scripts/bump-version.ts",
    "create_pr": "bun scripts/create-pr.ts",
    "watch:css": "onchange \"src/scss\" -- run-s build:css",
    "watch:js": "onchange \"src/js\" -- run-s build:js",
    "watch:images": "onchange \"src/images\" -- run-s build:images",
    "watch": "run-p serve watch:*",
    "copy-assets": "cp -r favicon/ dist/favicon/ && sed 's|=\"dist/|=\"|g' index.html > dist/index.html && cp favicon/favicon.ico CNAME robots.txt sitemap.xml dist/",
    "postinstall": "run-s build"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "browser-sync": "^3.0.4",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "htmlhint": "^1.9.2",
    "imagemin-cli": "^8.0.0",
    "mkdirp": "^3.0.1",
    "npm-run-all": "^4.1.5",
    "onchange": "^7.1.0",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.1",
    "rimraf": "^6.1.3",
    "sass": "^1.102.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-scss": "^6.14.0",
    "uglify-js": "^3.19.3"
  },
  "homepage": "https://agent.appifyhub.com",
  "main": ".eslintrc.js"
}
